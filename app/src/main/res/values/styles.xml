<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#086859</item>
        <item name="android:colorControlHighlight">#24086859</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F8F8</item>
        <item name="android:navigationBarColor">#F5F8F8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F5F8F8</item>
        <item name="android:alertDialogTheme">@style/CampusDialog</item>
    </style>
    <style name="CampusDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#086859</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:textColorPrimary">#263C38</item>
        <item name="android:textColorSecondary">#6D807B</item>
    </style>
</resources>
